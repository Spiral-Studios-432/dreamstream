{
  "name": "Reflection",
  "type": "object",
  "properties": {
    "prompt": {
      "type": "string",
      "description": "The reflection prompt"
    },
    "response": {
      "type": "string",
      "description": "User's reflection response"
    },
    "mood": {
      "type": "string",
      "enum": [
        "grateful",
        "hopeful",
        "peaceful",
        "motivated",
        "reflective",
        "curious"
      ],
      "description": "Mood during reflection"
    },
    "reflection_date": {
      "type": "string",
      "format": "date",
      "description": "Date of reflection"
    },
    "credits_earned": {
      "type": "number",
      "default": 5,
      "description": "Credits earned for completing"
    }
  },
  "required": [
    "prompt",
    "response",
    "reflection_date"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "created_by": "{{user.email}}"
    },
    "delete": {
      "created_by": "{{user.email}}"
    }
  }
}